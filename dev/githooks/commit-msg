#!/bin/sh
# Enforces Conventional Commits on the subject line.
#   <type>[optional scope][!]: <description>
# Enable once per clone:  git config core.hooksPath dev/githooks
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

# merges and fixups are left alone
case "$subject" in
  Merge\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].{0,71}$'; then
  echo "commit-msg: subject is not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo "expected: <type>[(scope)][!]: <description>   e.g. feat(trophies): add blooded trophies" >&2
  echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
