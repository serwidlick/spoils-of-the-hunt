<?xml version="1.0" encoding="UTF-8"?>
<!-- Spoils of the Hunt TEST HARNESS: declares the variables the harness writes so the game persists them
     to Documents\The Witcher 3\dx12user.settings, where they can be read from outside the game.
     Installed only with build.ps1 -Install -TestHarness; never packaged. Also shows up under Options > Mods. -->
<UserConfig>
	<Group id="SpoilsOfTheHuntTest" displayName="SpoilsOfTheHuntTest">
		<VisibleVars>
			<Var id="LTwithN"        displayName="LTwithN"        displayType="SLIDER:0:100000:100000"/>
			<Var id="LTwithSum"      displayName="LTwithSum"      displayType="SLIDER:0:100000000:100000000"/>
			<Var id="LTwithoutN"     displayName="LTwithoutN"     displayType="SLIDER:0:100000:100000"/>
			<Var id="LTwithoutSum"   displayName="LTwithoutSum"   displayType="SLIDER:0:100000000:100000000"/>
			<Var id="LTratioX1000"   displayName="LTratioX1000"   displayType="SLIDER:0:10000:10000"/>
			<Var id="LTequipHybridX1000" displayName="LTequipHybridX1000" displayType="SLIDER:0:10000:10000"/>
			<Var id="LTequipAnyBonus"    displayName="LTequipAnyBonus"    displayType="SLIDER:0:1:1"/>
			<Var id="LTpowerBaseX1000"   displayName="LTpowerBaseX1000"   displayType="SLIDER:0:100000000:100000000"/>
			<Var id="LTpowerMultX1000"   displayName="LTpowerMultX1000"   displayType="SLIDER:0:100000000:100000000"/>
			<Var id="LTpowerAddX1000"    displayName="LTpowerAddX1000"    displayType="SLIDER:0:100000000:100000000"/>
		</VisibleVars>
	</Group>
</UserConfig>
